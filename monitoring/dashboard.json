{
  "uid": "itcs355-service",
  "title": "ITCS355 \u2014 Prediction service",
  "description": "Lab 4 dashboard as code. Provisioned by monitoring/stack; every panel maps to a series in service/monitoring.py.",
  "tags": [
    "itcs355",
    "lab4"
  ],
  "timezone": "Asia/Bangkok",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(model_version_info, job)",
          "refId": "job"
        },
        "definition": "label_values(model_version_info, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "local",
          "value": "local"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Model version in production",
      "type": "stat",
      "description": "One tile per (model version, image build) currently reporting. Two tiles outside a canary means something is wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "count by (model_version, build_sha) (model_version_info{job=~\"$job\"})",
          "legendFormat": "model v{{model_version}} \u00b7 build {{build_sha}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Drift window fill",
      "type": "stat",
      "description": "Readings in the rolling window. PSI is only reported once it reaches 500 \u2014 the size the threshold was calibrated for.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "feature_window_size{job=~\"$job\"}",
          "legendFormat": "readings",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Availability (SLO 99.5%, excl. 4xx)",
      "type": "stat",
      "description": "Successful / total over the dashboard's time range, 4xx excluded, as monitoring/slo.yaml defines it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "1 - (sum(increase(http_requests_total{job=~\"$job\",path=~\"/predict.*\",status_class=\"5xx\"}[$__range])) or vector(0)) / sum(increase(http_requests_total{job=~\"$job\",path=~\"/predict.*\",status_class!=\"4xx\"}[$__range]))",
          "legendFormat": "availability",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "p95 latency now",
      "type": "stat",
      "description": "Server-side p95 of /predict over the last 5 minutes. Target 200 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket{job=~\"$job\",path=\"/predict\"}[5m])))",
          "legendFormat": "p95",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Request rate",
      "type": "timeseries",
      "description": "Prediction requests per second, by route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"/predict.*\"}[1m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Error rate by class",
      "type": "timeseries",
      "description": "4xx is usually a caller problem \u2014 but a sudden 4xx spike is how a unit change upstream (e.g. Fahrenheit) shows up, because the schema rejects it. 5xx is ours and burns the error budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "(sum(rate(http_requests_total{job=~\"$job\",path=~\"/predict.*\",status_class=\"4xx\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=~\"$job\",path=~\"/predict.*\"}[5m]))",
          "legendFormat": "4xx \u2014 caller sent bad input"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "(sum(rate(http_requests_total{job=~\"$job\",path=~\"/predict.*\",status_class=\"5xx\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=~\"$job\",path=~\"/predict.*\"}[5m]))",
          "legendFormat": "5xx \u2014 our fault"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Latency p50 / p95 / p99 (/predict)",
      "type": "timeseries",
      "description": "Measured at the endpoint, not the client. Dashed line: the 200 ms p95 target. A p99 far above p95 in a repeating pattern means cold starts or a per-request model load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(request_latency_ms_bucket{job=~\"$job\",path=\"/predict\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket{job=~\"$job\",path=\"/predict\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(request_latency_ms_bucket{job=~\"$job\",path=\"/predict\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Feature drift \u2014 PSI over the rolling 500-reading window",
      "type": "timeseries",
      "description": "PSI of the last 500 accepted readings against the training reference. Dashed line: 0.10, the paging threshold for physical sensors. load_pct pages at 0.29 because its PSI mostly reflects which machines are reporting (see README).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "feature_window_psi{job=~\"$job\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "temp_c \u2014 rolling mean vs training reference",
      "type": "timeseries",
      "description": "The injected-drift exercise shifts this feature. A shifted mean with a clean schema is drift; a 4xx spike with a flat mean is a broken producer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "feature_window_mean{job=~\"$job\",feature=\"temp_c\"}",
          "legendFormat": "rolling mean (last 500)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "feature_reference_mean{job=~\"$job\",feature=\"temp_c\"}",
          "legendFormat": "training reference"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Feature drift \u2014 PSI as a share of its own threshold",
      "type": "timeseries",
      "description": "Each feature against its own limit, so load_pct and the sensors share one scale. Crossing 100% is what the scheduled detector pages on.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "feature_window_psi{job=~\"$job\"} / on(feature, job, instance) feature_psi_threshold{job=~\"$job\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
